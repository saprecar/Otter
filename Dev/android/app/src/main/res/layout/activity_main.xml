<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Camera Preview Viewfinder with Front Screen Glow Frame -->
    <FrameLayout
        android:id="@+id/viewfinderContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp"
        android:background="#000000"
        android:padding="0dp">

        <TextureView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/screenGlowBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Status & Info Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Otter: Ready"
            android:textColor="#238636"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cameraIndicatorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#21262D"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Lens: BACK [0]"
            android:textColor="#58A6FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#21262D"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="About"
            android:textColor="#58A6FF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/streamInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="IP: -- | Port: 8089 (USB ADB / WiFi)"
        android:textColor="#8B949E"
        android:textSize="11sp" />

    <!-- Scrollable Controls Container for Responsive Multi-Screen Support -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary Controls: Start, Pause, Stop, Switch Camera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#238636"
                    android:text="Start"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D29922"
                    android:text="Pause"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DA3633"
                    android:text="Stop"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnSwitchCam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#30363D"
                    android:text="Flip"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Secondary Controls: Resolution, Mirror Deflip, & Software Rotation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <Button
                    android:id="@+id/btnResolution"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1F6FEB"
                    android:text="Res: 720p"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnMirror"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#388BFD"
                    android:text="Mirror: OFF"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnRotate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8957E5"
                    android:text="Rotate: 0°"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Background & Anti-Kill Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <Button
                    android:id="@+id/btnBackgroundLock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#8957E5"
                    android:text="Lock Mode: ON"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnBatteryGuide"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#30363D"
                    android:text="OEM Battery Fix"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Lighting Controls: Flashlight & Front Screen Glow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <Button
                    android:id="@+id/btnTorch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#D29922"
                    android:text="Torch: OFF"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnScreenGlow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F0883E"
                    android:text="Glow: OFF"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- Manual Camera Focus & Exposure Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="2dp">

                <Button
                    android:id="@+id/btnFocusMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#238636"
                    android:text="AF: Auto"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnManualFocus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#30363D"
                    android:text="Focus: Inf"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnExposure"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#30363D"
                    android:text="EV: 0"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
